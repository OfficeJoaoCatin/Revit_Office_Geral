<Window x:Class="RevitFamilyImporter.UI.SheetTitleBlockSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerador de Folhas"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1F6F8B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D8F6F"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Border Padding="18" Background="#F4F6F8">
        <StackPanel>
            <TextBlock Text="Gerador de Folhas"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Atualiza folhas e carimbo a partir da Lista Mestra."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Lista Mestra"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtExcelPath"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Procurar"
                        Margin="8,0,0,0"
                        Click="Browse_Click"/>
            </Grid>

            <TextBlock Text="Disciplina"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbDiscipline"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="Eletrica" IsSelected="True"/>
                <ComboBoxItem Content="Hidraulica"/>
                <ComboBoxItem Content="Outra"/>
            </ComboBox>

            <CheckBox x:Name="ChkUpdateExistingOnly"
                      Content="Atualizar folhas existentes"
                      Checked="UpdateExistingOnly_Changed"
                      Unchecked="UpdateExistingOnly_Changed"
                      Margin="0,2,0,12"/>

            <TextBlock x:Name="TxtTitleBlockLabel"
                       Text="Familia / tipo do carimbo"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbTitleBlock"
                      DisplayMemberPath="DisplayName"
                      Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkSelectSheets"
                      Content="Selecionar quais folhas gerar/atualizar"
                      Margin="0,2,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="90"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Confirmar"
                        Width="96"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
