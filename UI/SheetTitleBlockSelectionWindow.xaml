<Window x:Class="RevitFamilyImporter.UI.SheetTitleBlockSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecione as folhas"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D8F6F"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Selecione as folhas"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="TxtSummary"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch"
                     VerticalContentAlignment="Center"
                     TextChanged="Search_TextChanged"/>
            <Button Grid.Column="1"
                    Content="Marcar todos"
                    Margin="8,0,0,0"
                    Click="SelectAll_Click"/>
            <Button Grid.Column="2"
                    Content="Desmarcar todos"
                    Margin="8,0,0,0"
                    Click="DeselectAll_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DataGrid x:Name="GridSheets"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      IsReadOnly="False"
                      RowHeight="32"
                      ColumnHeaderHeight="34"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E9EDF3"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Width="44" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Numero" Width="120" Binding="{Binding SheetNumber}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nome" Width="*" Binding="{Binding SheetName}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Revisao" Width="90" Binding="{Binding CurrentRevision}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Confirmar"
                    Width="96"
                    Foreground="White"
                    Background="{StaticResource AccentBrush}"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
