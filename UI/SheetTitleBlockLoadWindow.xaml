<Window x:Class="RevitFamilyImporter.UI.SheetTitleBlockLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lendo Lista Mestra"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D8F6F"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    </Window.Resources>

    <Border Padding="18">
        <StackPanel>
            <TextBlock Text="Lendo Lista Mestra"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtStatus"
                       Text="Preparando os dados das folhas..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>
            <ProgressBar Height="8"
                         IsIndeterminate="True"
                         Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>
    </Border>
</Window>
