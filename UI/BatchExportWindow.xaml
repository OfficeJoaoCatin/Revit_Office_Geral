<Window x:Class="RevitFamilyImporter.UI.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportacao em Lote"
        Width="1040" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F6F8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#1F6F8B"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#155568"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D8F6F"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B84242"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Exportacao em Lote"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding CurrentStatus}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Exportar"
                        Style="{StaticResource ActionButton}"
                        Background="{StaticResource AccentBrush}"
                        Command="{Binding ExportCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Cancelar"
                        Style="{StaticResource ActionButton}"
                        Background="{StaticResource DangerBrush}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabItem Header="Projetos">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Selecionar todos"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectAllDocumentsCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Desmarcar todos"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeselectAllDocumentsCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="0">
                        <DataGrid ItemsSource="{Binding Documents}"
                                  SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  RowHeight="34"
                                  ColumnHeaderHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9EDF3"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Width="42"
                                                        Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Projeto"
                                                    Binding="{Binding ProjectName}"
                                                    Width="220"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Folhas"
                                                    Binding="{Binding SheetCount}"
                                                    Width="80"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Arquivo"
                                                    Binding="{Binding DisplayPath}"
                                                    Width="*"
                                                    IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Folhas">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Modo"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SheetModes}"
                                  SelectedItem="{Binding SelectedSheetSelectionMode, Mode=TwoWay}"/>
                        <Button Grid.Column="3"
                                Content="Selecionar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectAllSheetsCommand}"
                                Margin="8,0,8,0"/>
                        <Button Grid.Column="4"
                                Content="Desmarcar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeselectAllSheetsCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="0">
                        <DataGrid ItemsSource="{Binding Sheets}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeight="34"
                                  ColumnHeaderHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9EDF3"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Width="42"
                                                        Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Projeto"
                                                    Binding="{Binding ProjectName}"
                                                    Width="190"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Numero"
                                                    Binding="{Binding Number}"
                                                    Width="130"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nome"
                                                    Binding="{Binding Name}"
                                                    Width="*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Disciplina"
                                                    Binding="{Binding Discipline}"
                                                    Width="150"
                                                    IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Emitida"
                                                        Binding="{Binding Issued}"
                                                        Width="90"
                                                        IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Configuracoes">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.ColumnSpan="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Destino"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2"
                                        Content="Escolher"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseFolderCommand}"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,12">
                            <StackPanel>
                                <CheckBox Content="PDF"
                                          IsChecked="{Binding ExportPdf, Mode=TwoWay}"
                                          FontWeight="Bold"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="Setup PDF" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding PdfSettings}"
                                          SelectedItem="{Binding SelectedPdfSettings, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Margin="0,4,0,10"/>
                                <CheckBox Content="Usar setup do proprio projeto"
                                          IsChecked="{Binding UseDocumentPdfSettings, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Combinar folhas por projeto"
                                          IsChecked="{Binding SelectedPdfSettings.Combine, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Vetor"
                                          IsChecked="{Binding SelectedPdfSettings.VectorMode, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Centralizar"
                                          IsChecked="{Binding SelectedPdfSettings.Center, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="DPI" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding DpiOptions}"
                                          SelectedItem="{Binding SelectedPdfSettings.DPI, Mode=TwoWay}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,12">
                            <StackPanel>
                                <CheckBox Content="DWG"
                                          IsChecked="{Binding ExportDwg, Mode=TwoWay}"
                                          FontWeight="Bold"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="Setup DWG" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding DwgSettings}"
                                          SelectedItem="{Binding SelectedDwgSettings, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Margin="0,4,0,10"/>
                                <CheckBox Content="Forcar setup global"
                                          IsChecked="{Binding ForceGlobalDwgSettings, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Exportar links"
                                          IsChecked="{Binding SelectedDwgSettings.ExportLinks, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Mesclar vistas"
                                          IsChecked="{Binding SelectedDwgSettings.MergeViews, Mode=TwoWay}"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="Versao" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding DwgVersions}"
                                          SelectedItem="{Binding SelectedDwgSettings.Version, Mode=TwoWay}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Nomenclatura" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Timeout por item (s)"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Tempo maximo para cada item da fila. Se exceder, o item e registrado como falha quando o Revit devolver o controle."/>
                                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Tempo maximo para cada item da fila. Se exceder, o item e registrado como falha quando o Revit devolver o controle."
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="RAM limite MB"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Limite de memoria do processo do Revit verificado entre itens. Acima do limite, a exportacao registra no log e executa limpeza controlada."/>
                                        <TextBox Text="{Binding MemoryLimitMb, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Limite de memoria do processo do Revit verificado entre itens. Acima do limite, a exportacao registra no log e executa limpeza controlada."
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Perfis" FontWeight="SemiBold"/>
                                <Grid Grid.Row="1" Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                              DisplayMemberPath="Name"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Salvar"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding SaveProfileCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Carregar"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding LoadProfileCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Excluir"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DeleteProfileCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Previa">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="Atualizar"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshPreviewCommand}"
                            Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="0">
                        <ListBox ItemsSource="{Binding PreviewItems}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderThickness="0"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Progresso">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="24"
                                             Minimum="0"
                                             Maximum="100"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                             Value="{Binding ProgressValue}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="#E7ECF2"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentStatus}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelBorder}"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sucesso: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.Succeeded}" Margin="0,0,16,0"/>
                                <TextBlock Text="Falhas: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.Failed}" Margin="0,0,16,0"/>
                                <TextBlock Text="Arquivos: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.Files.Count}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Abrir pasta"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenFolderCommand}"
                                    Margin="12,0,8,0"/>
                            <Button Grid.Column="2"
                                    Content="Abrir log"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenLogCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource PanelBorder}"
                            Margin="0,12,0,0"
                            Padding="0"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                        <ListBox ItemsSource="{Binding Report.Files}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 BorderThickness="0"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DestinationFolder}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ProgressText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
