<Window x:Class="RevitFamilyImporter.UI.ImportFamiliesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar Famílias — Revit Family Importer"
        Width="750" Height="600"
        MinWidth="550" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <!-- Recursos e estilos da janela -->
    <Window.Resources>
        <!-- Cor primária do tema -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#42A5F5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

        <!-- Estilo base para botões -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões secundários (outline) -->
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- Estilo para botão de cancelar -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#9E9E9E"/>
        </Style>
    </Window.Resources>

    <!-- Layout principal -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Cabeçalho com informações do arquivo -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de busca -->
            <RowDefinition Height="Auto"/>
            <!-- Informações e botões de seleção -->
            <RowDefinition Height="Auto"/>
            <!-- Lista de famílias (expansível) -->
            <RowDefinition Height="*"/>
            <!-- Barra de progresso -->
            <RowDefinition Height="Auto"/>
            <!-- Botões de ação -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ CABEÇALHO ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Título -->
            <TextBlock Text="Importar Famílias"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>

            <!-- Caminho do arquivo de origem -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Origem: "
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="txtFilePath"
                           Text="Nenhum arquivo selecionado"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="600"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>

            <!-- Separador -->
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ═══ BARRA DE BUSCA ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Border Background="White" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="10,6">
                <Grid>
                    <!-- Watermark (placeholder) -->
                    <TextBlock x:Name="txtSearchWatermark"
                               Text="🔍 Buscar família por nome ou categoria..."
                               Foreground="#BDBDBD" FontSize="13"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <!-- Campo de busca real -->
                    <TextBox x:Name="txtSearch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             VerticalAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ INFORMAÇÕES E BOTÕES DE SELEÇÃO ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Contador de famílias -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtFamilyCount"
                           Text="0 famílias encontradas"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text=" | " Foreground="{StaticResource BorderBrush}" Margin="4,0"/>
                <TextBlock x:Name="txtSelectedCount"
                           Text="0 selecionadas"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>

            <!-- Botões de seleção -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Selecionar Todos"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,5"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="BtnSelectAll_Click"/>
                <Button Content="Desmarcar Todos"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,5"
                        FontSize="11"
                        Click="BtnDeselectAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══ LISTA DE FAMÍLIAS (DATAGRID) ═══ -->
        <Border Grid.Row="3" Background="White" CornerRadius="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="0,0,0,12">
            <DataGrid x:Name="dgFamilies"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      RowHeight="36"
                      ColumnHeaderHeight="38"
                      FontSize="13"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA">

                <!-- Estilo do cabeçalho das colunas -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Foreground" Value="#424242"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Coluna: CheckBox de seleção -->
                    <DataGridTemplateColumn Header="✓" Width="45" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Click="CheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Coluna: Nome da família -->
                    <DataGridTextColumn Header="Nome da Família"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Coluna: Categoria -->
                    <DataGridTextColumn Header="Categoria"
                                        Binding="{Binding Category}"
                                        Width="180"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Coluna: Quantidade de tipos -->
                    <DataGridTextColumn Header="Tipos"
                                        Binding="{Binding TypeCount}"
                                        Width="70"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ BARRA DE PROGRESSO ═══ -->
        <StackPanel x:Name="pnlProgress" Grid.Row="4" Margin="0,0,0,12"
                    Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="progressBar"
                             Grid.Column="0"
                             Height="22"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="#E8E8E8"/>

                <TextBlock x:Name="txtProgress"
                           Grid.Column="1"
                           Text="0%"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <TextBlock x:Name="txtProgressStatus"
                       Text="Importando famílias..."
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ═══ BOTÕES DE AÇÃO ═══ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botão Cancelar (esquerda) -->
            <Button x:Name="btnCancel"
                    Grid.Column="0"
                    Content="Cancelar"
                    Style="{StaticResource CancelButton}"
                    HorizontalAlignment="Left"
                    MinWidth="100"
                    Click="BtnCancel_Click"/>

            <!-- Botão Importar (direita) -->
            <Button x:Name="btnImport"
                    Grid.Column="2"
                    Content="📥 Importar Selecionadas"
                    Style="{StaticResource ModernButton}"
                    Background="{StaticResource SuccessBrush}"
                    MinWidth="180"
                    FontSize="14"
                    Padding="20,10"
                    Click="BtnImport_Click"/>
        </Grid>
    </Grid>
</Window>
