<Window x:Class="RevitFamilyImporter.UI.BatchTypeParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Parâmetros"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Padding="18" Background="#F8FAFC">
        <StackPanel>
            <TextBlock Text="Editar parâmetro dos elementos selecionados"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Parâmetro"
                       Foreground="#374151"
                       Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbParameterName"
                      Height="30"
                      Margin="0,0,0,6"
                      IsEditable="False"
                      IsTextSearchEnabled="True"
                      MaxDropDownHeight="260"/>
            <TextBlock x:Name="TxtParameterSummary"
                       Foreground="#6B7280"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Valor"
                       Foreground="#374151"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="TxtValue"
                     Height="28"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Para parâmetros de comprimento, informe o valor em milímetros. Ex.: 1,5"
                       TextWrapping="Wrap"
                       Foreground="#6B7280"
                       FontSize="12"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="86"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Alterar"
                        Width="86"
                        Height="30"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>




