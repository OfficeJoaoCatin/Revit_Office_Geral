<Window x:Class="RevitFamilyImporter.UI.DetailImport.DetailImporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar Detalhes DWG"
        Width="1240"
        Height="780"
        WindowStartupLocation="CenterOwner"
        MinWidth="1120"
        MinHeight="700">
    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#12313B"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#24596A"/>
            <Setter Property="BorderBrush" Value="#24596A"/>
        </Style>
        <Style x:Key="PlainButton" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#24596A" Padding="18,12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"/>
                <StackPanel>
                    <TextBlock Text="Importar Detalhes DWG"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DestinationText}"
                               Foreground="#DDEEF2"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0"
                    Background="White"
                    BorderBrush="#D4DEE3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Arquivo DWG"
                               Style="{StaticResource HeaderText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Height="30"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding DwgPath}"/>
                    <Button Grid.Column="2"
                            Margin="10,0,0,0"
                            Content="Selecionar"
                            Command="{Binding SelectFileCommand}"
                            Style="{StaticResource PlainButton}"/>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Limites"
                                   FontSize="11"
                                   Foreground="#5B6A70"
                                   Margin="0,0,0,3"/>
                        <TextBox Height="24"
                                 Text="{Binding BoundaryLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Nomes"
                                   FontSize="11"
                                   Foreground="#5B6A70"
                                   Margin="0,0,0,3"/>
                        <TextBox Height="24"
                                 Text="{Binding NameLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="1"
                    Background="White"
                    BorderBrush="#D4DEE3"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Todos"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource PlainButton}"
                                    Margin="0,0,6,0"/>
                            <Button Content="Nenhum"
                                    Command="{Binding ClearSelectionCommand}"
                                    Style="{StaticResource PlainButton}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectionSummary}"
                                   Style="{StaticResource HeaderText}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Details}"
                              SelectedItem="{Binding SelectedDetail}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    Width="42"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="#"
                                                Width="46"
                                                IsReadOnly="True"
                                                Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Nome"
                                                Width="*"
                                                IsReadOnly="True"
                                                Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Largura"
                                                Width="82"
                                                IsReadOnly="True"
                                                Binding="{Binding Width}"/>
                            <DataGridTextColumn Header="Altura"
                                                Width="82"
                                                IsReadOnly="True"
                                                Binding="{Binding Height}"/>
                            <DataGridTextColumn Header="Entidades"
                                                Width="82"
                                                IsReadOnly="True"
                                                Binding="{Binding EntityCount}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="#5B6A70"
                               Text="{Binding ReportText}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Grid.RowSpan="2">
                <Border Background="White"
                        BorderBrush="#D4DEE3"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Criação"
                                   Style="{StaticResource HeaderText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Escala CAD" Grid.Row="0"/>
                            <TextBox Grid.Row="1"
                                     Height="28"
                                     Text="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Grid.Row="2"
                                      Margin="0,12,0,5"
                                      Content="Usar GstarCAD para alta fidelidade"
                                      IsChecked="{Binding UseGstarCadHighFidelity, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="3"
                                       Foreground="#5B6A70"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Padrão seguro: motor interno. A alta fidelidade abre o GstarCAD visível e só funciona com o CAD fechado."/>
                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                <TextBlock Text="Máx. entidades/detalhe"
                                           FontSize="11"
                                           Foreground="#5B6A70"
                                           Margin="0,0,0,3"/>
                                <TextBox Height="28"
                                         Text="{Binding MaxEntitiesPerDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D4DEE3"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Preview"
                                   Style="{StaticResource HeaderText}"/>
                        <Border BorderBrush="#D4DEE3"
                                BorderThickness="1"
                                Background="#FBFCFC"
                                Height="210"
                                HorizontalAlignment="Stretch">
                            <Image Source="{Binding SelectedDetail.Preview}"
                                   Stretch="Uniform"
                                   Margin="8"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedDetail.Name}"
                                   Margin="0,10,0,2"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Foreground="#5B6A70"
                                   Text="{Binding SelectedDetail.EntityCount, StringFormat={}{0} entidade(s)}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D4DEE3"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#5B6A70"
                           Text="{Binding StatusText}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Criar Legendas"
                            Command="{Binding InsertCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Cancelar"
                            Click="CancelButton_Click"
                            Style="{StaticResource PlainButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>



