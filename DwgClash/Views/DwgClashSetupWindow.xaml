<Window x:Class="RevitFamilyImporter.DwgClash.Views.DwgClashSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash 2D DWG x Revit" Width="860" Height="780" MinWidth="550" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Clash 2D DWG x Revit" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,5,0,14" Foreground="#555" TextWrapping="Wrap"
                   Text="Analisa o desenho 2D do DWG contra elementos visíveis na vista ativa."/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="DWG importado/vinculado:"/>
            <ComboBox Grid.Column="1" x:Name="DwgComboBox" DisplayMemberPath="DisplayName" MinHeight="28" SelectionChanged="DwgComboBox_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Layer do DWG:"/>
            <ComboBox Grid.Column="1" x:Name="LayerComboBox" DisplayMemberPath="DisplayName" MinHeight="28"/>
        </Grid>
        <GroupBox Grid.Row="4" Header="Categorias Revit analisadas" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap"
                           Text="Somente elementos visíveis na vista ativa e nas categorias marcadas serão verificados."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.Resources>
                            <DataTemplate x:Key="CategoryOptionTemplate">
                                <CheckBox Margin="0,5" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="190"/><ColumnDefinition Width="*" MinWidth="190"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,8">
                            <TextBlock Text="Electrical" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ElectricalCategories" ItemsSource="{Binding ElectricalOptions}" ItemTemplate="{StaticResource CategoryOptionTemplate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="Hydraulic / Plumbing" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="HydraulicCategories" ItemsSource="{Binding HydraulicOptions}" ItemTemplate="{StaticResource CategoryOptionTemplate}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <TextBlock Text="Other" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="OtherCategories" ItemsSource="{Binding OtherOptions}" ItemTemplate="{StaticResource CategoryOptionTemplate}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
        <WrapPanel Grid.Row="5" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                <TextBlock VerticalAlignment="Center" Text="Tolerância (mm):" Margin="0,0,8,0"/>
                <TextBox x:Name="ToleranceTextBox" Text="5" Width="95" Height="30" Padding="5"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
                <RadioButton x:Name="IntersectionRadio" Content="Interseção geométrica" IsChecked="True" ToolTip="Compara a projeção 2D aproximada do elemento com a linha ou a região do DWG."/>
                <RadioButton x:Name="CenterRadio" Content="Centro do elemento" Margin="0,6,0,0" ToolTip="Sem considerar o interior, verifica a distância do centro à borda; com o interior, também aceita o centro dentro de uma região fechada."/>
                <CheckBox x:Name="ClosedRegionAreaCheckBox" Content="Considerar interior de regiões fechadas" Margin="0,7,0,0"
                          ToolTip="Desmarcado: somente a borda é considerada. Marcado: o interior da região fechada também é considerado."/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel Grid.Row="6" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Analisar" MinWidth="100" Padding="14,7" Margin="0,0,8,4" Click="AnalyzeButton_Click"/>
            <Button Content="Cancelar" MinWidth="100" Padding="14,7" Margin="0,0,0,4" Click="CancelButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
