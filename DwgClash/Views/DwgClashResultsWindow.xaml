<Window x:Class="RevitFamilyImporter.DwgClash.Views.DwgClashResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultados - Clash 2D DWG x Revit" Width="1280" Height="760" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Clash 2D DWG x Revit" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryTextBlock" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap" MaxHeight="55" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MemoryStatusText" Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"
                       Text="As marcações são pessoais e salvas neste computador; uma nova análise recalcula os conflitos."/>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                  SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/></Trigger>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#BFE8C9"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#111827"/><Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#111827"/></Trigger></Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42" IsReadOnly="True"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Família" Binding="{Binding Family}" Width="*" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="ID Revit" Binding="{Binding ElementId}" Width="85" IsReadOnly="True"/>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Região" Binding="{Binding RegionName}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Distância" Binding="{Binding DistanceText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Concluído" Width="90" IsReadOnly="True" CanUserSort="True" SortMemberPath="IsCompleted">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="Marcar conflito como concluído para este usuário" PreviewMouseDoubleClick="Completed_DoubleClick"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Margin="0,10,0,10" Foreground="#1f4e79" TextWrapping="Wrap"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Anterior" Padding="12,6" Margin="0,0,6,4" Click="PreviousButton_Click"/>
            <Button Content="Próximo" Padding="12,6" Margin="0,0,6,4" Click="NextButton_Click"/>
            <Button Content="Selecionar / enquadrar" Padding="12,6" Margin="0,0,6,4" Click="SelectButton_Click"/>
            <Button Content="Criar avisos na planta" Padding="12,6" Margin="0,0,6,4" Click="CreateMarkersButton_Click"/>
            <Button Content="Exportar CSV" Padding="12,6" Margin="0,0,6,4" Click="ExportCsvButton_Click"/>
            <Button Content="Exportar JSON" Padding="12,6" Margin="0,0,6,4" Click="ExportJsonButton_Click"/>
            <Button Content="Fechar" Padding="18,6" Margin="0,0,0,4" Click="CloseButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
