<Window x:Class="RevitFamilyImporter.DwgClash.Views.DwgClashResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultados - Clash 2D DWG x Revit" Width="1120" Height="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Clash 2D DWG x Revit" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryTextBlock" Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="150" />
                <DataGridTextColumn Header="Família" Binding="{Binding Family}" Width="190" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="190" />
                <DataGridTextColumn Header="ID Revit" Binding="{Binding ElementId}" Width="78" />
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="130" />
                <DataGridTextColumn Header="Região" Binding="{Binding RegionName}" Width="90" />
                <DataGridTextColumn Header="Distância" Binding="{Binding DistanceText}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Margin="0,10,0,10" Foreground="#1f4e79" />
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Anterior" Padding="12,6" Margin="0,0,6,0" Click="PreviousButton_Click" />
                <Button Content="Próximo" Padding="12,6" Margin="0,0,6,0" Click="NextButton_Click" />
                <Button Content="Selecionar / enquadrar" Padding="12,6" Margin="0,0,6,0" Click="SelectButton_Click" />
                <Button Content="Destacar" Padding="12,6" Margin="0,0,6,0" Click="HighlightButton_Click" />
                <Button Content="Limpar destaques" Padding="12,6" Click="ClearHighlightButton_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Exportar CSV" Padding="12,6" Margin="0,0,6,0" Click="ExportCsvButton_Click" />
                <Button Content="Exportar JSON" Padding="12,6" Margin="0,0,6,0" Click="ExportJsonButton_Click" />
                <Button Content="Fechar" Padding="18,6" Click="CloseButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
