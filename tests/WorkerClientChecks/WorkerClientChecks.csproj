<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Remove="FakeWorker\**\*.cs" />
    <Compile Include="..\..\Import\DetailImport\GstarCadDetailExporter.cs" Link="Client.cs" />
    <Compile Include="..\..\Models\DetailImport\DwgBounds.cs" Link="DwgBounds.cs" />
    <Compile Include="..\..\Models\DetailImport\DwgPoint2.cs" Link="DwgPoint2.cs" />
    <ProjectReference Include="FakeWorker\FakeWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFakeWorker" AfterTargets="Build">
    <Copy SourceFiles="FakeWorker\bin\$(Configuration)\OfficeGstarCadWorker.exe" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
