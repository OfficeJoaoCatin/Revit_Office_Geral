<Window x:Class="RevitFamilyImporter.LinkConflict.Views.LinkConflictSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflitos em Link" Width="600" Height="590" MinWidth="450" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#EEF2F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Analisar conflitos em modelo vinculado" FontSize="20" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Escolha o link e marque uma ou mais categorias para comparar com o modelo hospedeiro." Foreground="#475569" Margin="0,6,0,14" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Text="Link carregado" Foreground="#64748B"/>
        <ComboBox x:Name="LinkComboBox" Grid.Row="3" ItemsSource="{Binding Links}" DisplayMemberPath="DisplayName" MinHeight="30" Margin="0,4,0,12" SelectionChanged="LinkComboBox_SelectionChanged"/>
        <DockPanel Grid.Row="4" Margin="0,0,0,6">
            <TextBlock Text="Categorias no link" Foreground="#64748B" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SelectAllButton" Content="Selecionar todas" Margin="6,0,0,0" Padding="8,3" Click="SelectAll_Click"/>
                <Button x:Name="ClearButton" Content="Limpar" Margin="6,0,0,0" Padding="8,3" Click="Clear_Click"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="CategoriesList" Grid.Row="5" MinHeight="80" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3"/></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,8,0,8" Foreground="#475569" TextWrapping="Wrap"/>
        <WrapPanel Grid.Row="7" HorizontalAlignment="Right">
            <Button Content="Cancelar" MinWidth="90" Margin="0,0,8,0" Padding="10,6" Click="Cancel_Click"/>
            <Button x:Name="AnalyzeButton" Content="Analisar" MinWidth="100" Padding="10,6" IsDefault="True" Click="Analyze_Click"/>
        </WrapPanel>
    </Grid>
</Window>
