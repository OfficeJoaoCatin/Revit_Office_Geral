<Window x:Class="RevitFamilyImporter.LinkConflict.Views.LinkConflictSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflitos em Link"
        Width="560"
        Height="300"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Analisar conflitos em modelo vinculado" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock Grid.Row="1" Text="Escolha o link carregado e a categoria interna para comparar com o modelo hospedeiro." Foreground="#475569" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Text="Link carregado" Foreground="#64748B"/>
        <ComboBox x:Name="LinkComboBox" Grid.Row="3" ItemsSource="{Binding Links}" DisplayMemberPath="DisplayName" Height="30" Margin="0,4,0,10" SelectionChanged="LinkComboBox_SelectionChanged"/>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Categoria no link" Foreground="#64748B"/>
            <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="DisplayName" Height="30" Margin="0,4,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="90" Click="Cancel_Click"/>
                <Button Content="Analisar" Width="100" IsDefault="True" Click="Analyze_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
