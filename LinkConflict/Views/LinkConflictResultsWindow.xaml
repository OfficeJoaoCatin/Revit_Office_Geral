<Window x:Class="RevitFamilyImporter.LinkConflict.Views.LinkConflictResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflitos em Link"
        Width="1180"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Conflitos em Link" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock x:Name="SummaryText" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Categoria host:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#334155"/>
                <ComboBox x:Name="HostCategoryComboBox" Width="170" Height="27" Margin="0,0,8,0"/>
                <Button Content="Criar avisos na planta" Width="155" Margin="0,0,8,0" Click="CreateMarkers_Click"/>
                <Button Content="Exportar avisos" Width="120" Click="Export_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="ConflictsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Conflict_SelectionChanged" MouseDoubleClick="Conflict_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/>
                    <DataGridTextColumn Header="Elemento no link" Binding="{Binding LinkedElementId}" Width="110"/>
                    <DataGridTextColumn Header="Família / tipo no link" Binding="{Binding LinkedType}" Width="2*"/>
                    <DataGridTextColumn Header="Elemento host" Binding="{Binding HostElementId}" Width="100"/>
                    <DataGridTextColumn Header="Categoria host" Binding="{Binding HostCategory}" Width="140"/>
                    <DataGridTextColumn Header="Família / tipo host" Binding="{Binding HostType}" Width="2*"/>
                    <DataGridTextColumn Header="Interseção" Binding="{Binding IntersectionText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <TextBlock x:Name="DetailsText" Foreground="#334155" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Anterior" Width="90" Click="Previous_Click"/>
                <Button Content="Próximo" Width="90" Click="Next_Click"/>
                <Button Content="Selecionar host" Width="110" Click="SelectHost_Click"/>
                <Button Content="Enquadrar host" Width="110" Click="ShowHost_Click"/>
                <Button Content="Selecionar link" Width="110" Click="SelectLinked_Click"/>
                <Button Content="Enquadrar link" Width="110" Click="ShowLinked_Click"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Fechar" Width="90" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
