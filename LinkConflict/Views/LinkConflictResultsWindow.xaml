<Window x:Class="RevitFamilyImporter.LinkConflict.Views.LinkConflictResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflitos em Link" Width="1180" Height="720" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#EEF2F6">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Conflitos em Link" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock x:Name="SummaryText" Foreground="#475569" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>
            <TextBlock x:Name="MemoryStatusText" Text="As marcações são pessoais e salvas neste computador; uma nova análise recalcula os conflitos." Foreground="#64748B" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <WrapPanel>
                <TextBlock Text="Categoria host:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="#334155"/>
                <ComboBox x:Name="HostCategoryComboBox" Width="170" Height="28" Margin="0,0,8,4"/>
                <Button Content="Criar avisos na planta" Padding="10,5" Margin="0,0,8,4" Click="CreateMarkers_Click"/>
                <Button Content="Exportar avisos" Padding="10,5" Margin="0,0,8,4" Click="Export_Click"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="ConflictsGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="Conflict_SelectionChanged" MouseDoubleClick="Conflict_DoubleClick" EnableRowVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/></Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#BFE8C9"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#111827"/></Trigger></Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Elemento no link" Binding="{Binding LinkedElementId}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Categoria no link" Binding="{Binding LinkedCategory}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Família / tipo no link" Binding="{Binding LinkedType}" Width="*" MinWidth="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Elemento host" Binding="{Binding HostElementId}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Categoria host" Binding="{Binding HostCategory}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Família / tipo host" Binding="{Binding HostType}" Width="*" MinWidth="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Interseção" Binding="{Binding IntersectionText}" Width="120" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Concluído" Width="90" IsReadOnly="True" CanUserSort="True" SortMemberPath="IsCompleted">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Marcar conflito como concluído para este usuário" PreviewMouseDoubleClick="Completed_DoubleClick"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <TextBlock x:Name="DetailsText" Foreground="#334155" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Anterior" MinWidth="80" Margin="0,0,6,4" Padding="8,5" Click="Previous_Click"/>
            <Button Content="Próximo" MinWidth="80" Margin="0,0,6,4" Padding="8,5" Click="Next_Click"/>
            <Button Content="Selecionar host" Margin="0,0,6,4" Padding="8,5" Click="SelectHost_Click"/>
            <Button Content="Enquadrar host" Margin="0,0,6,4" Padding="8,5" Click="ShowHost_Click"/>
            <Button Content="Selecionar link" Margin="0,0,6,4" Padding="8,5" Click="SelectLinked_Click"/>
            <Button Content="Enquadrar link" Margin="0,0,6,4" Padding="8,5" Click="ShowLinked_Click"/>
            <Button Content="Fechar" MinWidth="80" Margin="0,0,0,4" Padding="8,5" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
