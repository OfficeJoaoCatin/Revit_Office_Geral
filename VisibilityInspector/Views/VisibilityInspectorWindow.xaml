<Window x:Class="RevitFamilyImporter.VisibilityInspector.Views.VisibilityInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RevitFamilyImporter.VisibilityInspector.Models"
        Title="Visibility Inspector"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Report.OverallStatus}" Value="OCULTO">
                    <Setter Property="Background" Value="#FED7AA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Report.OverallStatus}" Value="ATENÇÃO">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#166534"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Report.OverallStatus}" Value="OCULTO">
                    <Setter Property="Foreground" Value="#9A3412"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Report.OverallStatus}" Value="ATENÇÃO">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DetailTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#475569" Margin="20,2,0,2"/>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VisibilityIssue}" ItemsSource="{Binding Details}" ItemTemplate="{StaticResource DetailTemplate}">
            <DockPanel Margin="0,4">
                <Border Width="28" Height="22" CornerRadius="3" Background="#E2E8F0" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="{Binding Summary}" Foreground="#475569" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Visibility Inspector" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="{Binding Report.Summary}" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Exportar" Command="{Binding ExportCommand}"/>
                <Button Content="Resolver problemas" Command="{Binding ResolveProblemsCommand}"/>
                <Button Content="PDF" Command="{Binding PrintPdfCommand}" CommandParameter="{Binding ElementName=PrintableArea}"/>
                <Button Content="Comparar Vista" Command="{Binding CompareViewCommand}"/>
                <Button Content="Onde aparece" Command="{Binding FindViewsCommand}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="Elemento" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                    <TextBlock Text="ID" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.ElementId}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Origem" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.ElementSource}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Link" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.LinkInstanceName, TargetNullValue=-, FallbackValue=-}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Arquivo vinculado" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.LinkedDocumentTitle, TargetNullValue=-, FallbackValue=-}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Categoria" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.Category}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Família" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.Family}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Tipo" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.Type}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Vista analisada" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Report.ViewName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock Text="Status Geral" Foreground="#64748B"/>
                    <Border Style="{StaticResource StatusBorderStyle}" CornerRadius="5" Padding="8" Margin="0,4,0,14">
                        <TextBlock Text="{Binding Report.OverallStatus}" FontSize="18" FontWeight="Bold" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Problemas priorizados" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <ItemsControl ItemsSource="{Binding Report.Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2" Foreground="{Binding ProblemForeground}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8">
                <TabControl x:Name="PrintableArea">
                    <TabItem Header="Diagnóstico">
                        <TreeView ItemsSource="{Binding Issues}" BorderThickness="0" Padding="8"/>
                    </TabItem>
                    <TabItem Header="Mapa de Visibilidade">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Flow}" Margin="20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border CornerRadius="5" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="#475569"/>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#475569"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Margin="0,4"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Filtros">
                        <DockPanel Margin="8">
                            <TextBox DockPanel.Dock="Top" Height="28" Margin="0,0,0,8" Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGrid ItemsSource="{Binding Filters}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Aplicado" Binding="{Binding AppliedText}" Width="80"/>
                                    <DataGridTextColumn Header="Atende" Binding="{Binding PassesText}" Width="80"/>
                                    <DataGridTextColumn Header="Oculta" Binding="{Binding HiddenText}" Width="80"/>
                                    <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="120"/>
                                    <DataGridTextColumn Header="Peso" Binding="{Binding Weight}" Width="70"/>
                                    <DataGridTextColumn Header="Transp." Binding="{Binding Transparency}" Width="80"/>
                                    <DataGridTextColumn Header="Meio tom" Binding="{Binding Halftone}" Width="90"/>
                                    <DataGridTextColumn Header="Prioridade" Binding="{Binding Priority}" Width="80"/>
                                    <DataGridTextColumn Header="Conclusão" Binding="{Binding Conclusion}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Overrides">
                        <DataGrid ItemsSource="{Binding Overrides}" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="Alvo" Binding="{Binding Target}" Width="2*"/>
                                <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="3*"/>
                                <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="120"/>
                                <DataGridTextColumn Header="Peso" Binding="{Binding Weight}" Width="70"/>
                                <DataGridTextColumn Header="Transp." Binding="{Binding Transparency}" Width="80"/>
                                <DataGridTextColumn Header="Meio tom" Binding="{Binding Halftone}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Propriedades">
                        <DataGrid ItemsSource="{Binding Parameters}" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="3*"/>
                                <DataGridTextColumn Header="StorageType" Binding="{Binding StorageType}" Width="120"/>
                                <DataGridCheckBoxColumn Header="ReadOnly" Binding="{Binding ReadOnly}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Comparação">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Report.Comparison.ComparedView, StringFormat=Vista comparada: {0}}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding ComparisonDifferences}"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Onde aparece">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="#475569" Margin="0,0,0,8"/>
                            <Button DockPanel.Dock="Bottom" Content="Abrir vista selecionada" HorizontalAlignment="Right" Margin="0,8,0,0" Command="{Binding OpenViewCommand}" CommandParameter="{Binding SelectedViewResult}"/>
                            <DataGrid ItemsSource="{Binding ViewResults}" SelectedItem="{Binding SelectedViewResult}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vista" Binding="{Binding ViewName}" Width="2*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding ViewType}" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="6" DockPanel.Dock="Top"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#475569" Margin="0,6,0,0"/>
        </DockPanel>
    </Grid>
</Window>
