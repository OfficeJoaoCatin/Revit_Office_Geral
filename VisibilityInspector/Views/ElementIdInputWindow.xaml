<Window x:Class="RevitFamilyImporter.VisibilityInspector.Views.ElementIdInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informar ID do Elemento"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Border Padding="16">
        <StackPanel>
            <TextBlock Text="ID do elemento"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Use este modo quando o elemento não aparece na vista ativa. A análise será feita contra a vista ativa atual."
                       Foreground="#475569"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <TextBox x:Name="ElementIdTextBox"
                     Height="30"
                     Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="86"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Analisar"
                        Width="86"
                        Height="30"
                        IsDefault="True"
                        Click="Analyze_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
