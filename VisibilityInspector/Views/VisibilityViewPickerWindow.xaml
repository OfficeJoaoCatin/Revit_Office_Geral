<Window x:Class="RevitFamilyImporter.VisibilityInspector.Views.VisibilityViewPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparar Vista"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Escolha a vista para comparar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Comparar" Width="90" Height="30" IsDefault="True" Click="Compare_Click"/>
        </StackPanel>
        <ListBox x:Name="ViewsList" DisplayMemberPath="DisplayName"/>
    </DockPanel>
</Window>
