<?xml version="1.0" encoding="utf-8"?>
<!--
  Arquivo de manifesto (.addin) para o plugin Revit Family Importer.
  
  Compatível com Revit 2023, 2024, 2025 e 2026.
  
  INSTALAÇÃO:
  Copie este arquivo para uma das seguintes pastas:
    - Para o usuário atual:
      %APPDATA%\Autodesk\Revit\Addins\2025\
    - Para todos os usuários:
      C:\ProgramData\Autodesk\Revit\Addins\2025\
  
  Ajuste "2025" para a versão do Revit desejada (2023, 2024, 2025 ou 2026).
  
  O caminho da DLL (Assembly) deve apontar para o local real do arquivo compilado.
-->
<RevitAddIns>

  <!-- Registro da aplicação (cria aba e botão na Ribbon ao iniciar o Revit) -->
  <AddIn Type="Application">
    <Name>Revit Family Importer</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.App</FullClassName>
    <AddInId>3A4B5C6D-7E8F-4901-A2B3-C4D5E6F70031</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
    <VendorEmail>contato@bimtools.com.br</VendorEmail>
  </AddIn>

  <!-- Registro do comando (necessário para o TransactionMode funcionar) -->
  <AddIn Type="Command">
    <Name>Importar Famílias</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.ImportFamiliesCommand</FullClassName>
    <AddInId>4B5C6D7E-8F90-4A12-B3C4-D5E6F7003142</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Exportação em Lote</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.BatchExportCommand</FullClassName>
    <AddInId>10C71F2C-2764-4AF8-A3F2-6A2D54E59145</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Salvar Tudo</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.SaveAllOpenDocumentsCommand</FullClassName>
    <AddInId>93D2A4C5-5F9E-4F7B-A4D0-3E7B65A45501</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Sincronizar Centrais</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.SynchronizeOpenCentralModelsCommand</FullClassName>
    <AddInId>D5A33F0C-0A3F-4C1D-9AD5-5CC0E7164822</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>


  <AddIn Type="Command">
    <Name>Editar Parâmetros</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.BatchTypeParameterUpdateCommand</FullClassName>
    <AddInId>31F5DBF5-8FC0-4C3D-A816-42D79C64F3F1</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Legenda CAD</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.GenerateLegendLibraryCommand</FullClassName>
    <AddInId>8DDB5F0E-46C8-4D51-A092-BB55C3E5D13B</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Selecionar Idênticos</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.Commands.SelectIdenticalElementsCommand</FullClassName>
    <AddInId>2C4F8D69-9D84-49B1-A5A5-338D4C293746</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <Name>Visibility Inspector</Name>
    <Assembly>C:\Teste Revit\RevitFamilyImporter\bin\Release\RevitFamilyImporter.dll</Assembly>
    <FullClassName>RevitFamilyImporter.VisibilityInspector.Commands.VisibilityInspectorCommand</FullClassName>
    <AddInId>5EB6C1C5-D145-4F3D-9FD3-0C8D76B2C801</AddInId>
    <VendorId>BIM_TOOLS</VendorId>
    <VendorDescription>BIM Tools - Ferramentas para Revit</VendorDescription>
  </AddIn>
</RevitAddIns>

